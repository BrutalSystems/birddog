# Go
/bin/
/dist/
*.test
*.out
coverage.*

# Node (opencode plugin)
node_modules/
*.tgz
.npmrc

# Credentials and local runtime state
.env
.env.*
*.pem
*.key
*.log
*.jsonl
# …except committed test fixtures. The blanket rule above exists so a real
# session transcript is never committed by accident, and it silently excluded
# the redacted fixture that pins Claude Code's record shape: green locally,
# where the file is on disk, and red in CI, which checks out only what is
# tracked. `make check` now refuses an ignored file under any testdata/.
!**/testdata/*.jsonl
*.sqlite
*.sqlite-shm
*.sqlite-wal
# An instance store is named .db, not .sqlite, and replaying a corpus means
# copying real ones somewhere to read them. They hold session ids, workspace
# paths and target ids, which are frequently a customer's name.
*.db
*.db-shm
*.db-wal
# Same escape hatch as above, for the same reason: a blanket rule that hides a
# fixture passes locally and fails in CI.
!**/testdata/*.db
.birddog/

# Live-probe records and private working notes stay local.
# The raw record of what was inspected on a developer's machine never ships;
# what it established belongs in docs/providers.md instead.
probes/
.private/
integration-findings.md
.superpowers/

# macOS
.DS_Store
